    <div class="row g-3">
        <div class="col-md-4"><div class="card p-3"><p class="mb-1">Utilisateurs</p><p class="h3 mb-0">{{ userCount }}</p></div></div>
        <div class="col-md-4"><div class="card p-3"><p class="mb-1">Commandes payées</p><p class="h3 mb-0">{{ paidPurchaseCount }}</p></div></div>
        <div class="col-md-4"><div class="card p-3"><p class="mb-1">Certifications délivrées</p><p class="h3 mb-0">{{ certificationCount }}</p></div></div>
    </div>
{% endblock %}

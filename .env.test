# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# E-mails are never really sent during the tests (they are captured by the Symfony mailer logger).
MAILER_DSN=null://null
# Fake test key: the tests replace the Stripe HTTP client, no request reaches Stripe.
STRIPE_SECRET_KEY=sk_test_fake_key_for_unit_tests

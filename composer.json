{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/orm": "^3.7",
        "easycorp/easyadmin-bundle": "^5.7",
        "stripe/stripe-php": "^22.0",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*",
        "symfonycasts/verify-email-bundle": "^1.18",
        "twig/extra-bundle": "^3.29"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": [
            "@php bin/phpunit --testdox"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S 127.0.0.1:8001 -t public"
        ],
        "db:init": [
            "@php bin/console doctrine:migrations:migrate --no-interaction",
            "@php bin/console doctrine:fixtures:load --no-interaction"
        ],
        "docs": [
            "@php tools/phpDocumentor.phar run --config phpdoc.dist.xml"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "name": "orionlazu/knowledge-learning",
    "description": "Knowledge Learning: e-learning and e-commerce platform (Symfony 7.4)",
    "scripts-descriptions": {
        "test": "Runs the unit and functional tests (test database knowledge_learning_test).",
        "start": "Starts the local web server on http://127.0.0.1:8001.",
        "db:init": "Creates the tables and loads the demonstration data.",
        "docs": "Generates the code documentation in docs/api with phpDocumentor."
    }
}
